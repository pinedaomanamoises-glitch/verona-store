# Copia este archivo como .env y coloca tu clave real.
# La clave se obtiene en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Modelo de Gemini. Si tu clave no tiene acceso a 2.5-flash, prueba otro modelo
# disponible en tu cuenta (por ejemplo gemini-3.8-flash).
GEMINI_MODEL=gemini-2.5-flash

# Orígenes permitidos por CORS. En producción pon la URL exacta del frontend,
# por ejemplo: https://tu-usuario.github.io
ALLOWED_ORIGINS=*

# Peticiones por minuto y por IP.
RATE_LIMIT_PER_MINUTE=30

# Render inyecta PORT automáticamente. En local se usa 3000.
# PORT=3000
